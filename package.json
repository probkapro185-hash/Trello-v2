    "db:types": "node scripts/generate-types.mjs",
    "db:test:cli": "supabase test db",
    "db:test:realtime": "node scripts/test-realtime.mjs",
    "storage:cleanup": "node scripts/storage-cleanup.mjs",
    "db:test:collaboration": "node scripts/test-collaboration.mjs",
    "test:tasks": "node scripts/test-task-groups.mjs",
    "test:production": "node scripts/test-production.mjs",
    "deploy:preflight": "node scripts/preflight.mjs",
    "db:benchmark": "node scripts/benchmark-db.mjs",
    "db:test:invite-race": "node scripts/test-invite-race.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
